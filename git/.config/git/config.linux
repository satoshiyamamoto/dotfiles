[core]
  editor = vim
  pager = LESSCHARSET=utf-8 less --quit-if-one-screen --no-init
  whitespace = cr-at-eol

[diff]
  colorMoved = dimmed-zebra
  tool = vimdiff

[difftool]
  prompt = false

[merge]
  conflictStyle = zdiff3
  tool = vimdiff

[mergetool]
  prompt = false
  keepBackup = false

[pull]
	rebase = true

[ghq]
  root = ~/Projects/src

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

# The same GCM as macOS, from Nix (nix/modules/home/linux.nix) instead of the
# cask, found on PATH as git-credential-manager. A headless host has neither
# a Keychain nor a Secret Service, and the gpg store needs `pass init` first,
# so tokens go to ~/.gcm/store in plain files -- mode 600, the same footing as
# gh's own hosts.yml. GitHub sign-in falls back to the device-code flow.
[credential]
	helper =
	helper = manager
	credentialStore = plaintext
