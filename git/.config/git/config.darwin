[core]
  editor = nvim
  pager = hunk pager
  whitespace = cr-at-eol

# hunk's pager parses ANSI-coloured input in quadratic time, so an unbounded
# `git log` on a large history stalls for over a minute before drawing anything.
# Diffs keep hunk; log alone falls back to less.
[pager]
  log = less -R

[diff]
  tool = nvimdiff
  colorMoved = dimmed-zebra

[difftool]
  prompt = false

[difftool "nvimdiff"]
  cmd = nvim -R -d "$LOCAL" "$REMOTE"

[merge]
  conflictStyle = zdiff3
  tool = nvimdiff

[mergetool]
  prompt = false
  keepBackup = false

[mergetool "nvimdiff"]
  cmd = nvim -d -c "4wincmd w | wincmd J" "$LOCAL" "$BASE" "$REMOTE" "$MERGED"

[pull]
	rebase = true

[ghq]
  root = ~/Projects/src

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[credential]
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager

# GCM stores tokens in the macOS Keychain, which is unreadable from a non-Aqua
# session (ssh login), so it re-prompts every time. gh keeps its token in a
# plain file and works in both. Must stay after the reset above to survive it.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
