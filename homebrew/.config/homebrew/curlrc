# Stall detection for Homebrew downloads, injected via $HOMEBREW_CURLRC.
#
# Homebrew's Ruby-side curl_args (Library/Homebrew/utils/curl.rb) passes no
# --speed-limit, --speed-time or --max-time when fetching bottles and casks,
# so a connection that goes silent mid-transfer is only broken by the OS TCP
# timeout. Observed in practice: a ghcr.io bottle stalled at 23 MB of 213 MB
# and sat at 0 B/s for over 10 minutes before curl's --retry 3 kicked in.
#
# The shell-side curl (utils/curl.sh) and the API downloader (api.rb) do set
# these, at 100 B/s over 5 s. The limit below is deliberately looser on time
# and tighter on speed: 10 kB/s sustained for 30 s. Anything genuinely alive
# clears that bar, while a dead socket is dropped in 30 s instead of 10 min.
# Lower speed-limit if a slow link (tethering, hotel Wi-Fi) trips this.
speed-limit = 10000
speed-time = 30
